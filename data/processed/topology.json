  "data_mapping": {
    "comment": "Maps Frame.Pressure and Frame.Flow array indices to physical measurements",
    "pressure_indices": {
      "0": "FlowSource.B (pump outlet) - MAIN MANIFOLD",
      "1": "ReliefValve.A (inlet) - same as pressure[0]",
      "2": "ReliefValve.B (outlet/return)",
      "3": "VentValve.A (inlet) - same as pressure[0]",
      "4": "VentValve.B (outlet/return)",
      "5": "DirectionalValve.P (pump port) - same as pressure[0]",
      "6": "DirectionalValve.T (tank return port)",
      "7": "DirectionalValve.A (cap-end port) - same as pressure[9]",
      "8": "DirectionalValve.B (rod-end port) - same as pressure[10]",
      "9": "Cylinder.A (cap-end chamber) - same as pressure[7]",
      "10": "Cylinder.B (rod-end chamber) - same as pressure[8]",
      "11": "CheckValve.A (inlet) - same as pressure[8]",
      "12": "CheckValve.B (outlet) - same as pressure[10]",
      "13": "FlowRestriction.A (inlet) - same as pressure[10]",
      "14": "FlowRestriction.B (outlet)",
      "15": "Filter.A (inlet) - same as pressure[6]",
      "16": "Filter.B (outlet) - same as pressure[17]",
      "17": "Tank.A (inlet) - same as pressure[16]"
    },
    "flow_indices": {
      "0": "FlowSource.B (pump outlet flow)",
      "1": "ReliefValve.A (relief flow)",
      "2": "VentValve.A (vent flow)",
      "3": "DirectionalValve.P (pump port flow)",
      "4": "DirectionalValve.T (tank return flow)",
      "5": "DirectionalValve.A (cap-end flow)",
      "6": "DirectionalValve.B (rod-end flow)",
      "7": "CheckValve.A (check valve flow)",
      "8": "FlowRestriction.A (restriction flow)",
      "9": "Filter.A (filter flow)",
      "10": "Tank.A (tank inlet flow)"
    },
    "rod_data": {
      "velocity": "Frame.rod.vel (m/s) - integrate for position"
    }
  },
  "visualization_notes": {
    "pipe_pressure": "Use pressure_index from connections, map to blue→red gradient (0-224 kPa range)",
    "pipe_flow": "Use flow_index from connections, map to line thickness and particle speed",
    "components": "Simple labeled nodes - no pressure visualization on components",
    "manifold_handling": "Pipes 01, 03, 05 share same pressure (main manifold) - render as connected branches",
    "flow_direction": "Positive flow = from→to, negative flow = to→from (particle direction)",
    "cylinder_animation": "Integrate rod.vel over time to get rod position, animate Z-offset"
  }
